# ==============================================================================
# Production Environment Configuration Template
# ==============================================================================

# Project & Server
PROJECT_NAME="LocalGPT Cloud AI Platform"
ENVIRONMENT="production"
DEBUG=false
BACKEND_HOST="0.0.0.0"
BACKEND_PORT=8000
API_V1_STR="/api/v1"

# Production PostgreSQL Database
# Format: postgresql://<user>:<password>@<host>:<port>/<dbname>
DATABASE_URL="postgresql://postgres:postgres_secure_password@postgres:5432/localgpt_db"
DB_POOL_SIZE=15
DB_MAX_OVERFLOW=25
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800
DB_ECHO=false

# Security & JWT Secrets
SECRET_KEY="generate-a-strong-random-64-character-secret-key-here"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Google OAuth 2.0 Credentials (Get from https://console.cloud.google.com/apis/credentials)
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-client-secret"
GOOGLE_REDIRECT_URI="http://localhost:8000/api/v1/auth/google/callback"
GOOGLE_FRONTEND_REDIRECT_URI="http://localhost:3000/auth/callback"

# CORS Allowed Origins
FRONTEND_URL="http://localhost:3000"
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# Hosted LLM Inference Configuration (Groq / OpenAI / OpenRouter)
LLM_PROVIDER="groq"
LLM_API_KEY="gsk_your_groq_or_openai_api_key_here"
LLM_BASE_URL="https://api.groq.com/openai/v1"
LLM_MODEL="llama-3.3-70b-versatile"
LLM_TEMPERATURE=0.7
LLM_TOP_P=0.9
LLM_MAX_TOKENS=2048

# Document RAG & Storage
UPLOAD_DIRECTORY="./data/documents"
MAX_UPLOAD_SIZE_MB=25
