# ==============================================================================
# FastAPI Backend Configuration Example - Step 5: PostgreSQL Database
# ==============================================================================

# Project & Server
PROJECT_NAME="LocalGPT Cloud AI Platform"
ENVIRONMENT="development"
DEBUG=true
BACKEND_HOST="0.0.0.0"
BACKEND_PORT=8000
API_V1_STR="/api/v1"

# Database Configuration (PostgreSQL primary; SQLite local dev fallback)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/localgpt_db"
# SQLite fallback for quick local testing:
# DATABASE_URL="sqlite:///./platform.db"

# Database Connection Pooling Options
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800
DB_ECHO=false

# Security & Authentication (Zero plaintext passwords)
SECRET_KEY="replace-with-a-secure-random-secret-key"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Google OAuth 2.0 (Obtain from Google Cloud Console > APIs & Services > Credentials)
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-client-secret"
GOOGLE_REDIRECT_URI="http://localhost:8000/api/v1/auth/google/callback"
GOOGLE_FRONTEND_REDIRECT_URI="http://localhost:3000/auth/callback"

# CORS Configuration
FRONTEND_URL="http://localhost:3000"
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000","http://localhost:8000"]

# Hosted LLM Inference Configuration
LLM_PROVIDER="groq"
LLM_API_KEY="your-llm-api-key-here"
LLM_BASE_URL="https://api.groq.com/openai/v1"
LLM_MODEL="llama-3.3-70b-versatile"
LLM_TEMPERATURE=0.7
LLM_TOP_P=0.9
LLM_MAX_TOKENS=2048

# Document & RAG Storage
UPLOAD_DIRECTORY="./data/documents"
MAX_UPLOAD_SIZE_MB=25
