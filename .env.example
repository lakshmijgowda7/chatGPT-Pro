# ==============================================================================
# PROJECT 3 — CHATGPT-STYLE AI PLATFORM ENVIRONMENT CONFIGURATION
# ==============================================================================

# Backend Server Configuration
PROJECT_NAME="ChatGPT-Style AI Platform"
API_V1_STR="/api/v1"
BACKEND_HOST="0.0.0.0"
BACKEND_PORT=8000
DEBUG=true

# Database Configuration (PostgreSQL with SQLite fallback for local development)
# Production PostgreSQL example: postgresql://user:password@localhost:5432/chatgpt_db
DATABASE_URL="sqlite:///./data/conversations/platform.db"

# Hosted LLM Inference Configuration (No local LLM / No client GPU required)
# Options: Groq / OpenRouter / Together AI / OpenAI
LLM_PROVIDER="groq"
LLM_API_KEY="your-hosted-llm-api-key-here"
LLM_BASE_URL="https://api.groq.com/openai/v1"
LLM_MODEL="llama-3.3-70b-versatile"
LLM_TEMPERATURE=0.7
LLM_TOP_P=0.9
LLM_MAX_TOKENS=1024

# Frontend URL for CORS
FRONTEND_URL="http://localhost:3000"

# RAG & Document Storage
UPLOAD_DIRECTORY="./data/documents"
MAX_UPLOAD_SIZE_MB=25
